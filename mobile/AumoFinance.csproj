<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<!-- Metadata Aplikasi -->
    <ApplicationTitle>Aumo Mobile (C)</ApplicationTitle>
    <ApplicationId>com.bnrc.aumofinance.c</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>

    <!-- Bypass Workload Validation untuk Restore/Dependabot -->
    <MauiEnableWorkloadValidation>false</MauiEnableWorkloadValidation>
    <SkipImportWorkloadManifests>true</SkipImportWorkloadManifests>

    <!-- Target Framework Dynamic Fallback -->
    <TargetFramework Condition="'$(BuildingInsideVisualStudio)' == '' AND '$(GITHUB_ACTIONS)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(BuildingInsideVisualStudio)' != '' OR '$(GITHUB_ACTIONS)' != ''">net10.0-android36.0</TargetFramework>

    <OutputType>Exe</OutputType>
    <RootNamespace>AumoFinance</RootNamespace>

    <!-- Aktifkan MAUI hanya saat menargetkan Android -->
    <UseMaui Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</UseMaui>

    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Abaikan warning build spesifik (termasuk saran compiled-binding XC0022/XC0025) -->
    <NoWarn>$(NoWarn);NU1605;CS0649;CS0169;NETSDK1202;XC0022;XC0025</NoWarn>

    <!-- Mengunci batas minimal OS ke Android 9.0 (API Level 28) -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Konfigurasi Optimasi Build Release Android -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'android'">
    <PublishTrimmed>true</PublishTrimmed>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
  </PropertyGroup>

  <!-- Override Target untuk Membantu Restore CI/CD -->
  <Target Name="CheckForRequiredWorkloads" BeforeTargets="Restore;CollectPackageReferences" />

  <!-- Assets & Resources -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#1E121F" ForegroundScale="0.8" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" BaseSize="512,512" Resize="true" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Package Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />

    <!-- Database & Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.2" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />

    <!-- Authentication & Security -->
    <PackageReference Include="Plugin.Fingerprint" Version="3.0.0-beta.1" />
  </ItemGroup>

</Project>

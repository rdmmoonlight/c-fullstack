<!DOCTYPE html>
<html lang="en-US" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto:wght@300;400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- Base Framework Styles (Bootstrap & MudBlazor) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />

    <!-- Aumo Theme Styles (Di-load setelah Framework CSS agar Override Berhasil) -->
    <link rel="stylesheet" href="css/site.css" />
    <link rel="stylesheet" href="css/theme/theme.css" />
    <link rel="stylesheet" href="css/theme/topbar.css" />
    <link rel="stylesheet" href="css/theme/sidebar.css" />

    <!-- Scoped CSS bundle (MainLayout.razor.css, TopBar.razor.css) -->
    <link rel="stylesheet" href="AumoBlazor.styles.css" />

    <!-- Instant Theme Loader (Mencegah Layar Kedip / Flicker Saat Initial Load) -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('aumo_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <!-- Meta Head & Component State Outlet -->
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <!-- UI Penanganan Error Blazor -->
    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3" role="alert" style="display:none">
        An unhandled error has occurred.
        <a href="" class="reload link-primary">Reload</a>
        <a class="dismiss link-secondary">🗙</a>
    </div>

    <!-- JS Core & Third-Party Dependencies -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- MudBlazor Script -->
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>

    <!-- Global Site Script (window.aumoModal & window.aumoTheme) -->
    <script src="/js/site.js"></script>

    <!-- Global Theme Controller Function (Fallback) -->
    <script>
        window.setAppTheme = function (themeName) {
            document.documentElement.setAttribute('data-bs-theme', themeName);
            localStorage.setItem('aumo_theme', themeName);
        };
    </script>

    <!-- Blazor Framework Script -->
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

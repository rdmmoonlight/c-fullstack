@page "/JournalEntryDto/Create"
@page "/JournalEntryDto/Edit/{EntryId:int}"
@page "/journal-entry/create"
@page "/journal-entry/edit/{EntryId:int}"

@using System.Globalization
@using AumoBackend.DTOs.Reports
@using AumoBackend.Services.JournalEntries

@rendermode InteractiveServer
@attribute [Authorize]

@inject IJournalEntryService JournalService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UserContext User
@inject IChartOfAccountsService Accounts

<PageTitle>@(IsEdit ? "Edit Journal Entry" : "Create Journal Entry")</PageTitle>

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            @if (IsEdit)
            {
                <h2 class="fw-bold text-body-emphasis mb-1">
                    <i class="bi bi-pencil-square me-2 text-warning"></i> Edit Journal Entry
                    <span
                    class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-2">@transactionNumber</span>
                </h2>
                <p class="text-secondary mb-0">Update this double-entry transaction for Aumo Finance.</p>
            }
            else
            {
                <h2 class="fw-bold text-body-emphasis mb-1"><i class="bi bi-journal-plus me-2 text-warning"></i> Create
                    Journal Entry</h2>
                    <p class="text-secondary mb-0">Record double-entry financial transactions or adjusting entries for Aumo
                        Finance.</p>
                    }
                </div>
                <div>
                    <a href="/reports/general-journal" class="btn btn-outline-secondary shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Journal
                    </a>
                </div>
            </div>

            @if (successMessage != null)
            {
                <div class="alert alert-success shadow-sm py-2">
                    <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                </div>
            }

            @if (validationErrors.Any())
            {
                <div class="alert alert-danger shadow-sm py-2">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <ul class="mb-0 small fw-semibold">
                        @foreach (var error in validationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            @if (lockedMessage != null)
            {
                <div class="alert alert-warning shadow-sm py-2">
                    <i class="bi bi-lock-fill me-2"></i>@lockedMessage
                    <a href="/reports/general-journal" class="alert-link ms-1">Back to General Journal</a>
                </div>
            }
            else
            {
                <!-- Transaction Header Metadata -->
                <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
                    <div class="card-body p-4">
                        <div class="row g-3">
                            @if (IsEdit)
                            {
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold small">Transaction No.</label>
                                    <input type="text" class="form-control bg-body-secondary fw-semibold" value="@transactionNumber"
                                           readonly tabindex="-1" />
                                </div>
                            }
                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Journal Type</label>
                                <select class="form-select fw-semibold" @bind="journalType">
                                    <option value="General">General Journal (GJ)</option>
                                    <option value="Adjusting">Adjusting Entry (AJ)</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Transaction Date</label>
                                <input type="date" lang="id-ID" class="form-control" required
                                       value="@entryDate.ToString("yyyy-MM-dd")"
                                       @onchange="@(e => entryDate = DateTime.TryParse((string?)e.Value, out var dt) ? dt : DateTime.Today)" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Journal Lines Table -->
                <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
                    <div
                        class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                        <h5 class="mb-0 fw-bold text-body-emphasis"><i class="bi bi-list-task me-2 text-warning"></i> Journal Lines
                        </h5>
                        <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" @onclick="AddLine">
                            <i class="bi bi-plus-lg me-1"></i> Add Line
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 10%;" class="ps-4">Ref No.</th>
                                        <th style="width: 25%;">Account Name</th>
                                        <th style="width: 25%;">Description</th>
                                        <th style="width: 15%;" class="text-end">Debit</th>
                                        <th style="width: 15%;" class="text-end">Credit</th>
                                        <th style="width: 10%;" class="text-center pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="border-top-0">
                                    @foreach (var line in lines)
                                    {
                                        var accountRef = availableAccounts.FirstOrDefault(a => a.Id == line.AccountId)?.ReferenceNumber;
                                        <tr>
                                            <td class="ps-4">
                                                <input type="text" class="form-control text-center bg-body-secondary" readonly
                                                       tabindex="-1" placeholder="---" value="@(accountRef?.ToString() ?? "")" />
                                            </td>
                                            <td>
                                                <select class="form-select" @bind="line.AccountId">
                                                    <option value="0" disabled>Select Account...</option>
                                                    @foreach (var acc in availableAccounts)
                                                    {
                                                        <option value="@acc.Id">@acc.AccountName</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="position-relative">
                                                <input type="text" class="form-control" placeholder="Note..." autocomplete="off"
                                                       value="@line.LineDescription"
                                                       @oninput="@(e => OnDescriptionInput(line, (string?)e.Value))" />
                                                @if (line.ShowSuggestions && line.Suggestions.Any())
                                                {
                                                    <div class="list-group shadow-sm"
                                                         style="position:absolute; z-index:1060; top:100%; left:0; width:100%; max-height:220px; overflow-y:auto;">
                                                        @foreach (var suggestion in line.Suggestions)
                                                        {
                                                            <button type="button" class="list-group-item list-group-item-action small py-1"
                                                                    @onmousedown="@(() => SelectSuggestion(line, suggestion))"
                                                                    @onmousedown:preventDefault="true">
                                                                @suggestion
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <input type="number" step="any" class="form-control text-end" placeholder="0"
                                                       @bind="line.Debit" @bind:event="oninput" />
                                            </td>
                                            <td>
                                                <input type="number" step="any" class="form-control text-end" placeholder="0"
                                                       @bind="line.Credit" @bind:event="oninput" />
                                            </td>
                                            <td class="text-center pe-4">
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => RemoveLine(line)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light border-top fw-bold">
                                    <tr>
                                        <td colspan="3" class="text-end py-3">Total Balance:</td>
                                        <td class="text-end text-success fs-6 py-3">@TotalDebit.ToString("N0", CultureInfo)</td>
                                        <td class="text-end text-danger fs-6 py-3">@TotalCredit.ToString("N0", CultureInfo)</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end pb-3 border-bottom-0">Status:</td>
                                        <td colspan="2" class="text-center pb-3 border-bottom-0">
                                            @if (IsBalanced)
                                            {
                                                <span
                                                    class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2"><i
                                                    class="bi bi-check-circle me-1"></i> Balanced</span>
                                                }
                                    else
                                                {
                                                    <span
                                                        class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2"><i
                                                        class="bi bi-exclamation-triangle me-1"></i> Unbalanced (@Math.Abs(TotalDebit -
                                                        TotalCredit).ToString("N0", CultureInfo))</span>
                                                    }
                                                </td>
                                                <td class="border-bottom-0"></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Form Action Controls -->
                        <div class="d-flex justify-content-end gap-2">
                            @if (IsEdit)
                            {
                                <a href="/reports/general-journal" class="btn btn-outline-secondary px-4">Cancel</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary px-4" @onclick="ResetForm">Reset Form</button>
                            }
                            <button type="button" class="btn btn-primary fw-semibold px-4 shadow-sm" disabled="@(!IsBalanced)"
                                    @onclick="HandleSubmit">
                                <i class="bi bi-save me-1"></i> @(IsEdit ? "Save Changes" : "Post Journal Entry")
                            </button>
                        </div>
                    }
                </div>

@code {
    [Parameter] public int? EntryId { get; set; }
    private Guid UserId { get; set; }

    private static readonly CultureInfo CultureInfo = new("id-ID");
    private bool IsEdit => EntryId.HasValue;

    private List<LineItem> lines = new();
    private List<AccountItemDto> availableAccounts = new();
    private string journalType = "General";
    private DateTime entryDate = DateTime.Today;
    private string transactionNumber = string.Empty;
    private string? successMessage;
    private string? lockedMessage;
    private List<string> validationErrors = new();

    private decimal TotalDebit => lines.Sum(l => l.Debit ?? 0);
    private decimal TotalCredit => lines.Sum(l => l.Credit ?? 0);
    private bool IsBalanced => TotalDebit > 0 && TotalCredit > 0 && TotalDebit == TotalCredit;

    protected override async Task OnInitializedAsync()
    {
        UserId = await User.GetUserIdAsync();
        if (UserId == Guid.Empty)
        {
            Nav.NavigateTo("/auth/login", true);
            return;
        }

        // Daftar akun aktif berasal dari IChartOfAccountsService (backend).
        var accountList = await Accounts.GetAccountsAsync(UserId, null, null);
        availableAccounts = accountList.Accounts.Where(a => a.IsActive).OrderBy(a => a.ReferenceNumber).ToList();

        if (IsEdit)
        {
            var entry = await JournalService.GetByIdAsync(UserId, EntryId!.Value);
            if (entry is null)
            {
                lockedMessage = "The selected journal entry could not be loaded.";
                return;
            }

            if (entry.IsLocked)
            {
                lockedMessage = $"Journal entry {entry.TransactionNumber} falls within a closed period and cannot be modified.";
                return;
            }

            transactionNumber = entry.TransactionNumber;
            journalType = entry.JournalType;
            entryDate = entry.EntryDate;
            lines = entry.Lines.Select(l => new LineItem
            {
                AccountId = l.AccountId,
                LineDescription = l.LineDescription,
                Debit = l.Debit == 0 ? null : l.Debit,
                Credit = l.Credit == 0 ? null : l.Credit,
            }).ToList();
        }
        else
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        journalType = "General";
        entryDate = DateTime.Today;
        lines = new List<LineItem> { new LineItem(), new LineItem() };
        validationErrors.Clear();
    }

    private void AddLine() => lines.Add(new LineItem());

    private async Task RemoveLine(LineItem line)
    {
        if (lines.Count <= 2)
        {
            await JS.InvokeVoidAsync("alert", "A journal entry must have at least two line items (Debit & Credit).");
            return;
        }
        lines.Remove(line);
    }

    private void OnDescriptionInput(LineItem line, string? value)
    {
        line.LineDescription = value;
        line.SearchVersion++;
        var myVersion = line.SearchVersion;

        var query = value?.Trim() ?? "";
        if (query.Length < 2)
        {
            line.ShowSuggestions = false;
            line.Suggestions.Clear();
            return;
        }

        _ = DebouncedSearchAsync(line, query, myVersion);
    }

    private async Task DebouncedSearchAsync(LineItem line, string query, int myVersion)
    {
        await Task.Delay(250);
        if (line.SearchVersion != myVersion) return;

        var results = await JournalService.SearchLineDescriptionsAsync(UserId, query);
        if (line.SearchVersion != myVersion) return;

        line.Suggestions = results;
        line.ShowSuggestions = results.Any();
        await InvokeAsync(StateHasChanged);
    }

    private void SelectSuggestion(LineItem line, string text)
    {
        line.LineDescription = text;
        line.ShowSuggestions = false;
    }

    private async Task HandleSubmit()
    {
        validationErrors.Clear();
        successMessage = null;

        var requestLines = lines
            .Select((l, index) => new CreateGeneralJournalLineRequest
            {
                AccountId = l.AccountId,
                LineDescription = l.LineDescription,
                Debit = l.Debit ?? 0,
                Credit = l.Credit ?? 0,
                LineOrder = index + 1,
            })
            .ToList();

        try
        {
            // Validasi (akun aktif, saldo seimbang, periode tertutup) dilakukan IJournalEntryService.
            if (IsEdit)
            {
                await JournalService.UpdateAsync(UserId, EntryId!.Value, new UpdateGeneralJournalRequest
                {
                    JournalType = journalType,
                    EntryDate = entryDate,
                    TransactionNumber = transactionNumber,
                    Status = "Posted",
                    Lines = requestLines,
                });

                Nav.NavigateTo("/reports/general-journal");
                return;
            }

            var created = await JournalService.CreateAsync(UserId, new CreateGeneralJournalRequest
            {
                JournalType = journalType,
                EntryDate = entryDate,
                Lines = requestLines,
            });

            successMessage = $"Journal entry {created.TransactionNumber} has been posted.";
            ResetForm();
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("closed", StringComparison.OrdinalIgnoreCase))
        {
            lockedMessage = ex.Message;
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or KeyNotFoundException)
        {
            validationErrors = new List<string> { ex.Message };
        }
    }

    public class LineItem
    {
        public int AccountId { get; set; }
        public string? LineDescription { get; set; }
        public decimal? Debit { get; set; }
        public decimal? Credit { get; set; }

        public List<string> Suggestions { get; set; } = new();
        public bool ShowSuggestions { get; set; }
        public int SearchVersion { get; set; }
    }
}

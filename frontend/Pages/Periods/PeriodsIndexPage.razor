@page "/periods"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IPeriodsService PeriodsService
@inject UserContext User


@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Accounting Periods</PageTitle>

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-calendar3 me-2 text-primary"></i> Accounting Periods
            </h2>
            <p class="text-secondary mb-0">
                Manage your financial reporting cycles.
                Click <i class="bi bi-eye"></i> to view a period — the whole app (Dashboard, journals, reports) will
                follow it.
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (selectedPeriodId != null)
            {
                <button class="btn btn-outline-secondary fw-semibold shadow-sm" @onclick="ClearSelection">
                    <i class="bi bi-eye-slash me-1"></i> Stop Viewing
                </button>
            }
            <a href="/periods/create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Open New Period
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div
            class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center px-4">
            <h5 class="mb-0 fw-bold text-body-emphasis">Period List</h5>
            <span class="text-secondary small fw-semibold">Total Periods: @periods.Count</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Period Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div> Memuat data...
                                </td>
                            </tr>
                        }
                        else if (periods.Any())
                        {
                            @foreach (var period in periods)
                            {
                                var isSelected = selectedPeriodId == period.Id;
                                <tr class="@(isSelected ? "table-primary" : "")">
                                    <td class="ps-4 fw-bold text-body">
                                        @period.PeriodName
                                        @if (isSelected)
                                        {
                                            <span
                                                class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 small"><i
                                                class="bi bi-eye-fill me-1"></i>Viewing</span>
                                            }
                                        </td>
                                        <td><span class="text-secondary">@period.StartDate.ToString("dd MMM yyyy")</span></td>
                                        <td><span class="text-secondary">@period.EndDate.ToString("dd MMM yyyy")</span></td>
                                        <td class="text-center">
                                            @if (period.IsClosed)
                                            {
                                                <span
                                                    class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                                                    <i class="bi bi-lock-fill me-1"></i> Closed
                                                </span>
                                            }
                                            else
                                            {
                                                <span
                                                    class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                                    <i class="bi bi-unlock-fill me-1"></i> Active
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center pe-4">
                                            <div class="btn-group shadow-sm">
                                                <button type="button"
                                                        class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                                        title="View this period" @onclick="() => SelectPeriod(period)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                @if (!period.IsClosed)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-warning" title="Close Period"
                                                            @onclick="() => ConfirmAndClosePeriod(period)">
                                                        <i class="bi bi-lock"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-secondary">
                                        <i class="bi bi-calendar-x mb-3 d-block" style="font-size: 2.5rem;"></i>
                                        <p class="mb-0">No accounting periods have been initialized yet.</p>
                                        <small>Click "Open New Period" to start your first accounting cycle.</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

@code {
    private List<PeriodDto> periods = new();
    private int? selectedPeriodId;
    private bool isLoading = true;
    private string? successMessage;
    private string? errorMessage;
    private Guid userId;

    protected override async Task OnInitializedAsync()
    {
        userId = await User.GetUserIdAsync();
        if (userId == Guid.Empty)
        {
            Nav.NavigateTo("/auth/login", true);
            return;
        }

        await LoadPeriodsAsync();
        isLoading = false;
    }

    // Backend adalah SSOT: daftar periode, pemilihan periode aktif, dan aturan penutupan periode ada di IPeriodsService.
    private async Task LoadPeriodsAsync()
    {
        var result = await PeriodsService.GetPeriodsAsync(userId);
        periods = result.Periods.OrderByDescending(p => p.StartDate).ToList();
        selectedPeriodId = result.SelectedPeriodId;
    }

    private async Task SelectPeriod(PeriodDto period)
    {
        errorMessage = null;
        var result = await PeriodsService.SelectPeriodAsync(userId, period.Id);
        if (result is null || !result.Success)
        {
            errorMessage = result?.Message ?? "Period not found.";
            return;
        }

        successMessage = $"Now viewing {period.PeriodName}" + (period.IsClosed ? " (Closed)." : ".");
        await LoadPeriodsAsync();
    }

    private async Task ClearSelection()
    {
        errorMessage = null;
        var result = await PeriodsService.ClearSelectionAsync(userId);
        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        successMessage = "No period selected. Reports and journals are hidden until you view a period.";
        await LoadPeriodsAsync();
    }

    private async Task ConfirmAndClosePeriod(PeriodDto period)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to close {period.PeriodName}? No further edits will be allowed.");
        if (!confirmed) return;

        errorMessage = null;
        var result = await PeriodsService.ClosePeriodAsync(userId, period.Id);
        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        successMessage = $"Period {period.PeriodName} has been closed. Transactions in this period are now locked.";
        await LoadPeriodsAsync();
    }
}

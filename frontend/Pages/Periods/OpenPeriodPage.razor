@page "/periods/create"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IPeriodsService PeriodsService
@inject UserContext User


@inject NavigationManager Nav

<PageTitle>Open New Period</PageTitle>

<div class="container-fluid py-4 px-4" style="max-width: 900px;">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-calendar-plus me-2 text-primary"></i> Open New Period
            </h2>
            <p class="text-secondary mb-0">
                Start a new monthly accounting cycle. The opening balance entry is posted
                on day 1 of the period and will appear at the top of the General Journal.
            </p>
        </div>
        <a href="/periods" class="btn btn-outline-secondary fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5 text-secondary">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div> Memuat data...
        </div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="@(_ => HandleSubmit())">
            <DataAnnotationsValidator />

            <!-- Period Month/Year -->
            <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-3">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-body-emphasis">Period</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Month</label>
                            <select class="form-select" @bind="model.Month">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m">
                                        @System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(m)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Year</label>
                            <input type="number" class="form-control" @bind="model.Year" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Setup Mode -->
            <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-3">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-body-emphasis">Permanent Accounts Setup</h5>
                </div>
                <div class="card-body p-4">
                    <div class="btn-group w-100 mb-3" role="group">
                        <input type="radio" class="btn-check" name="setupMode" id="modeLoad" autocomplete="off"
                               checked="@(model.SetupMode == OpenPeriodViewModel.ModeLoadExisting)"
                               disabled="@(!model.HasExistingPermanentAccounts)"
                               @onchange="() => model.SetupMode = OpenPeriodViewModel.ModeLoadExisting" />
                        <label class="btn btn-outline-primary" for="modeLoad">
                            <i class="bi bi-arrow-repeat me-1"></i> Use Existing Accounts
                        </label>

                        <input type="radio" class="btn-check" name="setupMode" id="modeNew" autocomplete="off"
                               checked="@(model.SetupMode == OpenPeriodViewModel.ModeCreateNew)"
                               @onchange="() => model.SetupMode = OpenPeriodViewModel.ModeCreateNew" />
                        <label class="btn btn-outline-primary" for="modeNew">
                            <i class="bi bi-plus-circle me-1"></i> Register New Accounts
                        </label>
                    </div>

                    @if (!model.HasExistingPermanentAccounts)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            <i class="bi bi-info-circle me-1"></i> No existing Cash/Bank &amp; Retained Earnings accounts found
                            yet — this looks like your first period, so new accounts are required.
                        </div>
                    }

                    @if (model.SetupMode == OpenPeriodViewModel.ModeLoadExisting)
                    {
                        <p class="text-secondary small mb-3">
                            Balances carry forward automatically from the ledger — no opening journal entry is posted.
                        </p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Cash Account</label>
                                <select class="form-select" @bind="model.CashAccountId">
                                    @foreach (var a in model.AvailableCashAndBankAccounts)
                                    {
                                        <option value="@a.Id">@a.DisplayLabel</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Bank Account</label>
                                <select class="form-select" @bind="model.BankAccountId">
                                    @foreach (var a in model.AvailableCashAndBankAccounts)
                                    {
                                        <option value="@a.Id">@a.DisplayLabel</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Retained Earnings Account</label>
                                <select class="form-select" @bind="model.RetainedEarningsAccountId">
                                    @foreach (var a in model.AvailableRetainedEarningsAccounts)
                                    {
                                        <option value="@a.Id">@a.DisplayLabel</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary small mb-3">
                            An opening balance journal entry (General) will be posted on
                            <strong>@(new DateTime(model.Year, model.Month, 1).ToString("dd MMMM yyyy"))</strong>,
                            debiting Cash &amp; Bank and crediting Retained Earnings.
                        </p>
                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Cash Ref #</label>
                                <input class="form-control" @bind="model.CashAccountCode" placeholder="101" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Cash Account Name</label>
                                <input class="form-control" @bind="model.CashAccountName" placeholder="Cash on Hand" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Cash Opening Balance</label>
                                <input type="number" class="form-control" @bind="model.CashBalance" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Bank Ref #</label>
                                <input class="form-control" @bind="model.BankAccountCode" placeholder="102" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Bank Account Name</label>
                                <input class="form-control" @bind="model.BankAccountName" placeholder="Bank Account" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Bank Opening Balance</label>
                                <input type="number" class="form-control" @bind="model.BankBalance" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Retained Earnings Ref #</label>
                                <input class="form-control" @bind="model.RetainedEarningsAccountCode" placeholder="301" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label fw-semibold">Retained Earnings Account Name</label>
                                <input class="form-control" @bind="model.RetainedEarningsAccountName"
                                       placeholder="Retained Earnings" />
                            </div>
                        </div>
                        <div class="alert alert-secondary py-2 small mb-0">
                            Opening credit to Retained Earnings will be: <strong>@((model.CashBalance ?? 0) + (model.BankBalance
                                                                                ?? 0)).ToString("N0")</strong>
                        </div>
                    }

                    @if (model.PermanentAccounts.Any())
                    {
                        <hr class="my-3" />
                        <p class="fw-semibold small text-secondary mb-2">Existing permanent accounts (for reference):</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var a in model.PermanentAccounts)
                            {
                                <span class="badge bg-body-secondary text-body border px-2 py-1">@a.DisplayLabel</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="/periods" class="btn btn-outline-secondary fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-primary fw-semibold shadow-sm" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i> Open Period
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    private OpenPeriodForm model = new();
    private string? errorMessage;
    private bool isSubmitting;
    private bool isLoading = true;

    private Guid userId;

    protected override async Task OnInitializedAsync()
    {
        userId = await User.GetUserIdAsync();
        if (userId == Guid.Empty)
        {
            Nav.NavigateTo("/auth/login", true);
            return;
        }

        model.Month = DateTime.Today.Month;
        model.Year = DateTime.Today.Year;
        model.SetupMode = CreatePeriodRequest.ModeCreateNew;

        // Akun yang tersedia untuk pembukaan periode ditentukan backend.
        var info = await PeriodsService.GetOpenPeriodInfoAsync(userId);
        model.HasExistingPermanentAccounts = info.HasExistingPermanentAccounts;
        model.AvailableCashAndBankAccounts = info.AvailableCashAndBankAccounts;
        model.AvailableRetainedEarningsAccounts = info.AvailableRetainedEarningsAccounts;
        model.PermanentAccounts = info.PermanentAccounts;
        if (model.HasExistingPermanentAccounts)
        {
            model.SetupMode = CreatePeriodRequest.ModeLoadExisting;
        }

        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var request = new CreatePeriodRequest
            {
                Month = model.Month,
                Year = model.Year,
                SetupMode = model.SetupMode,
                CashAccountId = model.CashAccountId,
                BankAccountId = model.BankAccountId,
                RetainedEarningsAccountId = model.RetainedEarningsAccountId,
                CashAccountCode = model.CashAccountCode,
                CashAccountName = model.CashAccountName,
                CashBalance = model.CashBalance,
                BankAccountCode = model.BankAccountCode,
                BankAccountName = model.BankAccountName,
                BankBalance = model.BankBalance,
                RetainedEarningsAccountCode = model.RetainedEarningsAccountCode,
                RetainedEarningsAccountName = model.RetainedEarningsAccountName,
            };

            var result = await PeriodsService.CreatePeriodAsync(userId, request);
            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            Nav.NavigateTo("/periods");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    /// <summary>Model form saja. Validasi bisnis (bulan/tahun, akun, saldo) dilakukan backend.</summary>
    private sealed class OpenPeriodForm
    {
        public int Month { get; set; }
        public int Year { get; set; }
        public string SetupMode { get; set; } = CreatePeriodRequest.ModeLoadExisting;
        public int? CashAccountId { get; set; }
        public int? BankAccountId { get; set; }
        public int? RetainedEarningsAccountId { get; set; }
        public string? CashAccountCode { get; set; }
        public string? CashAccountName { get; set; }
        public decimal? CashBalance { get; set; }
        public string? BankAccountCode { get; set; }
        public string? BankAccountName { get; set; }
        public decimal? BankBalance { get; set; }
        public string? RetainedEarningsAccountCode { get; set; }
        public string? RetainedEarningsAccountName { get; set; }
        public List<AccountSimpleDto> PermanentAccounts { get; set; } = new();
        public List<AccountSimpleDto> AvailableCashAndBankAccounts { get; set; } = new();
        public List<AccountSimpleDto> AvailableRetainedEarningsAccounts { get; set; } = new();
        public bool HasExistingPermanentAccounts { get; set; }
    }
}

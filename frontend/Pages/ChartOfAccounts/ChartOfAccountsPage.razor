@page "/chart-of-accounts"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IChartOfAccountsService Accounts
@inject UserContext User

@using System.Globalization

@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Chart of Accounts</PageTitle>

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-diagram-3 me-2 text-warning"></i> Chart of Accounts
            </h2>
            <p class="text-secondary mb-0">Master list of financial accounts (Automatically sorted by reference).</p>
        </div>
        <div>
            <button class="btn btn-warning fw-semibold shadow-sm" data-bs-toggle="modal"
                    data-bs-target="#addAccountModal">
                <i class="bi bi-plus-lg me-1"></i> New Account
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- COA Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="d-flex gap-2">
                <input type="text" class="form-control form-control-sm" style="width: 250px;"
                       placeholder="Search accounts..." @bind="searchText" @bind:event="oninput" />
                <select class="form-select form-select-sm" style="width: 180px;" @bind="categoryFilter">
                    <option value="">All Categories</option>
                    @foreach (var type in AccountTypes)
                    {
                        <option value="@type">@FormatCategoryLabel(type)</option>
                    }
                </select>
            </div>
            <span class="text-secondary small fw-semibold">Total Accounts: @FilteredAccounts.Count()</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 120px;">Ref No.</th>
                            <th>Account Name</th>
                            <th>Category</th>
                            <th>Role</th>
                            <th class="text-end">Current Balance</th>
                            <th class="text-center" style="width: 100px;">Status</th>
                            <th class="text-center pe-4" style="width: 130px;">Action</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-secondary">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div> Loading account
                                    data...
                                </td>
                            </tr>
                        }
                        else if (FilteredAccounts.Any())
                        {
                            @foreach (var account in FilteredAccounts)
                            {
                                <tr>
                                    <td class="ps-4"><code>@account.ReferenceNumber</code></td>
                                    <td class="fw-bold text-body">@account.AccountName</td>
                                    <td><span class="badge bg-secondary text-light">@account.Type</span></td>
                                    <td>
                                        @if (account.Role != "Default")
                                        {
                                            <span class="badge bg-info text-dark">@account.Role</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">Standard</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold @(account.Balance >= 0 ? "text-success" : "text-danger")">
                                        Rp @account.Balance.ToString("N0", CultureId)
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(account.IsActive ? "bg-success" : "bg-danger")">
                                            @(account.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit Account"
                                                    data-bs-toggle="modal" data-bs-target="#editAccountModal"
                                                    @onclick="() => OpenEditModal(account)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <a href="@GetLedgerUrl(account)" class="btn btn-sm btn-outline-info"
                                               title="View General Ledger">
                                                <i class="bi bi-journal-text"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Account"
                                                    @onclick="() => ConfirmAndDelete(account)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-secondary">
                                    <i class="bi bi-diagram-3 mb-3 d-block" style="font-size: 2.5rem;"></i>
                                    No accounts found. Add a new account to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Account -->
<div class="modal fade" id="addAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-body-emphasis">
                    <i class="bi bi-plus-circle me-2 text-warning"></i> Add New Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <EditForm Model="newAccount" OnSubmit="HandleCreate">
                <div class="modal-body p-4">
                    @if (createError != null)
                    {
                        <div class="alert alert-danger py-2 small">@createError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Category</label>
                        <InputSelect class="form-select" @bind-Value="newAccount.Type">
                            <option value="">-- Select Category --</option>
                            @foreach (var type in AccountTypes)
                            {
                                <option value="@type">@FormatCategoryLabel(type)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Reference Number (Account Code)</label>
                        <InputNumber class="form-control" @bind-Value="newAccount.ReferenceNumber"
                                     disabled="@(string.IsNullOrEmpty(newAccount.Type))" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Name</label>
                        <InputText class="form-control" placeholder="e.g. Rent Expense"
                                   @bind-Value="newAccount.AccountName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">System Role (Special Calculations)</label>
                        <InputSelect class="form-select" @bind-Value="newAccount.Role">
                            <option value="Default">Standard / Default</option>
                            <option value="CashAndEquivalents">Cash &amp; Equivalents</option>
                            <option value="RetainedEarnings">Retained Earnings</option>
                            <option value="TaxPayable">Tax Payable</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Save Account</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- Modal Edit Account -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-body-emphasis">
                    <i class="bi bi-pencil-square me-2 text-warning"></i> Edit Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <EditForm Model="editAccount" OnSubmit="HandleEdit">
                <div class="modal-body p-4">
                    @if (editError != null)
                    {
                        <div class="alert alert-danger py-2 small">@editError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Category</label>
                        <InputSelect class="form-select" @bind-Value="editAccount.Type">
                            <option value="">-- Select Category --</option>
                            @foreach (var type in AccountTypes)
                            {
                                <option value="@type">@FormatCategoryLabel(type)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Reference Number (Account Code)</label>
                        <InputNumber class="form-control" @bind-Value="editAccount.ReferenceNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Name</label>
                        <InputText class="form-control" @bind-Value="editAccount.AccountName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">System Role (Special Calculations)</label>
                        <InputSelect class="form-select" @bind-Value="editAccount.Role">
                            <option value="Default">Standard / Default</option>
                            <option value="CashAndEquivalents">Cash &amp; Equivalents</option>
                            <option value="RetainedEarnings">Retained Earnings</option>
                            <option value="TaxPayable">Tax Payable</option>
                        </InputSelect>
                    </div>

                    <div class="form-check form-switch">
                        <InputCheckbox class="form-check-input" id="editIsActive" @bind-Value="editAccount.IsActive" />
                        <label class="form-check-label fw-semibold small" for="editIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Update Account</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo CultureId = new("id-ID");

    private static readonly string[] AccountTypes =
    {
        "Assets", "Liabilities", "Equity", "OperatingIncome",
        "OperatingExpenses", "OtherIncome", "OtherExpenses"
    };

    private List<AccountItemDto> accounts = new();
    private string? successMessage;
    private string? errorMessage;
    private string searchText = string.Empty;
    private string categoryFilter = string.Empty;

    private AccountItemDto newAccount = new() { Role = "Default" };
    private AccountItemDto editAccount = new();
    private bool isLoading = true;
    private string? createError;
    private string? editError;

    private Guid userId;

    protected override async Task OnInitializedAsync()
    {
        userId = await User.GetUserIdAsync();
        if (userId == Guid.Empty)
        {
            Nav.NavigateTo("/auth/login", true);
            return;
        }

        await LoadAccountsAsync();
        isLoading = false;
    }

    // Backend adalah SSOT daftar akun, nomor referensi, validasi, dan saldo.
    private async Task LoadAccountsAsync()
    {
        var result = await Accounts.GetAccountsAsync(userId, null, null);
        accounts = result.Accounts.ToList();
    }

    private IEnumerable<AccountItemDto> FilteredAccounts => accounts.Where(a =>
        (string.IsNullOrWhiteSpace(searchText)
            || a.AccountName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || a.ReferenceNumber.ToString().Contains(searchText))
        && (string.IsNullOrWhiteSpace(categoryFilter) || a.Type == categoryFilter));

    private static string FormatCategoryLabel(string type) => type switch
    {
        "Assets" => "Assets (100 - 199)",
        "Liabilities" => "Liabilities (200 - 299)",
        "Equity" => "Equity (300 - 399)",
        "OperatingIncome" => "Operating Income (400 - 499)",
        "OperatingExpenses" => "Operating Expenses (500 - 599)",
        "OtherIncome" => "Other Income (600 - 799)",
        "OtherExpenses" => "Other Expenses (800 - 999)",
        _ => type
    };

    private string GetLedgerUrl(AccountItemDto account)
    {
        return $"/reports/general-ledger#account-{account.Id}";
    }

    private async Task HandleCreate()
    {
        createError = null;

        var request = new CreateAccountRequestDto
        {
            ReferenceNumber = newAccount.ReferenceNumber,
            AccountName = newAccount.AccountName,
            Type = newAccount.Type,
            Role = newAccount.Role,
        };

        var result = await Accounts.CreateAccountAsync(userId, request);
        if (!result.IsSuccess)
        {
            createError = result.Message;
            return;
        }

        successMessage = $"Account '{newAccount.AccountName}' successfully created.";
        await JS.InvokeVoidAsync("aumoModal.hide", "addAccountModal");
        newAccount = new AccountItemDto { Role = "Default" };
        await LoadAccountsAsync();
    }

    private void OpenEditModal(AccountItemDto account)
    {
        editError = null;
        editAccount = new AccountItemDto
        {
            Id = account.Id,
            ReferenceNumber = account.ReferenceNumber,
            AccountName = account.AccountName,
            Type = account.Type,
            Role = account.Role,
            IsActive = account.IsActive,
        };
    }

    private async Task HandleEdit()
    {
        editError = null;

        // IsActive wajib dikirim: backend memperlakukan nilai yang hilang sebagai default kontrak.
        var request = new UpdateAccountRequestDto
        {
            ReferenceNumber = editAccount.ReferenceNumber,
            AccountName = editAccount.AccountName,
            Type = editAccount.Type,
            Role = editAccount.Role,
            IsActive = editAccount.IsActive,
        };

        var result = await Accounts.UpdateAccountAsync(userId, editAccount.Id, request);
        if (!result.IsSuccess)
        {
            editError = result.Message;
            return;
        }

        successMessage = $"Account '{editAccount.AccountName}' successfully updated.";
        await JS.InvokeVoidAsync("aumoModal.hide", "editAccountModal");
        await LoadAccountsAsync();
    }

    private async Task ConfirmAndDelete(AccountItemDto account)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete account \"{account.AccountName}\"? This action cannot be undone.");
        if (!confirmed) return;

        var result = await Accounts.DeleteAccountAsync(userId, account.Id);
        if (!result.IsSuccess)
        {
            errorMessage = result.Message;
            return;
        }

        successMessage = $"Account '{account.AccountName}' successfully deleted.";
        await LoadAccountsAsync();
    }
}

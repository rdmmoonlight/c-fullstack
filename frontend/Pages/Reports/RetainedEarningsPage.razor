@page "/reports/retained-earnings"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFinancialStatementsService Statements
@inject UserContext User
@inject SelectedPeriodProvider PeriodProvider
@inject NavigationManager Nav

@using System.Globalization
@using Microsoft.AspNetCore.Authorization



<div class="container-fluid">
    @if (noPeriodSelected)
    {
        <div class="text-center py-5 my-4">
            <i class="bi bi-eye-slash text-secondary mb-3 d-block" style="font-size: 2.5rem;"></i>
            <h5 class="fw-bold text-body-emphasis mb-2">No Period Selected</h5>
            <p class="text-secondary mb-3">This report follows whichever period you're viewing.</p>
            <a href="/periods" class="btn btn-primary btn-sm fw-semibold shadow-sm px-4">
                <i class="bi bi-calendar3 me-1"></i> Go to Periods
            </a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1"><i class="bi bi-piggy-bank me-2 text-success"></i> Retained Earnings Statement</h2>
                <p class="text-muted mb-0">Bridges the Income Statement and the Equity section on the Balance Sheet (US GAAP
                    / ASC 210).</p>
                </div>
                <div>
                    <a href="/reports/statement-of-financial-position" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-right-circle me-1"></i> Balance Sheet
                    </a>
                </div>
            </div>

            <div class="card bg-dark border-secondary text-white shadow-sm" style="max-width: 560px;">
                <div class="card-body">
                    <h5 class="mb-3">@vm.AccountName</h5>
                    <table class="table table-dark table-borderless align-middle mb-0">
                        <tbody>
                            <tr>
                                <td>Retained earnings, @vm.StartDate.ToString("MMMM d")</td>
                                <td class="text-end">@vm.BeginningBalance.ToString("N0", Idr)</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Add: Net Income for the Period</td>
                                <td class="text-end @(vm.NetIncome >= 0 ? "text-success" : "text-danger")">
                                    @vm.NetIncome.ToString("N0", Idr)</td>
                                </tr>
                                @if (vm.Dividends != 0)
                                {
                                    <tr>
                                        <td class="ps-3">Less: Dividends / Withdrawals</td>
                                        <td class="text-end text-danger">(@vm.Dividends.ToString("N0", Idr))</td>
                                    </tr>
                                }
                                <tr class="border-top border-secondary fw-bold fs-5" style="border-top-width: 3px !important;">
                                    <td class="pt-2">Retained earnings, @vm.EndDate.ToString("MMMM d")</td>
                                    <td class="text-end pt-2 text-success">@vm.EndingBalance.ToString("N0", Idr)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

@code {
    private static readonly CultureInfo Idr = new("id-ID");

    private RetainedEarningsViewModel vm = new();
    private bool noPeriodSelected;

    // Backend adalah SSOT: seluruh perhitungan laporan dilakukan IFinancialStatementsService.
    protected override async Task OnInitializedAsync()
    {
        var userId = await User.GetUserIdAsync();
        if (userId == Guid.Empty)
        {
            Nav.NavigateTo("/auth/login", true);
            return;
        }

        var period = await PeriodProvider.GetAsync(userId);
        if (period is null)
        {
            noPeriodSelected = true;
            return;
        }

        var response = await Statements.BuildRetainedEarningsAsync(userId, period);
        vm = ReportMapper.ToViewModel(response);
    }
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AumoFinance</RootNamespace>
    <UserSecretsId>3b80a545-4808-45e1-aed8-8b28c45e72fe</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project Reference ke Backend -->
    <ProjectReference Include="..\backend\AumoBackend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Components.Web & JwtBearer sudah bagian dari framework Microsoft.NET.Sdk.Web; referensi preview.1 dihapus agar tidak bentrok dengan runtime -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

</Project>

@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using AumoFinance.Layout.Theme

@* Menggunakan AumoTheme dari namespace AumoFinance.Layout.Theme *@
<MudThemeProvider Theme="AumoTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="d-flex flex-column min-vh-100 min-vw-0 aumo-main-shell">

    <!-- TOPBAR -->
    <AuthorizeView>
        <Authorized>
            <AumoFinance.Layout.TopBar />
        </Authorized>
    </AuthorizeView>

    <!-- SHELL UTAMA -->
    <div class="d-flex flex-grow-1 position-relative">
        
        <!-- SIDEBAR (Ditambahkan RenderMode InteractiveServer secara eksplisit) -->
        <AumoFinance.Layout.NavMenu />

        <!-- MAIN CONTENT AREA -->
        <main id="mainContent" class="content flex-grow-1 p-2 p-md-4 d-flex flex-column" role="main">
            @Body
        </main>

    </div>

</div>
